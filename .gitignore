# Data (raw dataset files and generic CSVs)
data/
*.csv

# Outputs: ignore temporary, figures, and scratch files by default
outputs/figures/*
outputs/models/*
outputs/results/*
mlruns/
scratch/

# Whitelist (Un-ignore): Track essential trained models, scaler, hashes, and loss results
!outputs/**/.gitkeep
!outputs/models/scaler.joblib
!outputs/models/checkpoints.sha256
!outputs/models/checkpoints.sha256.bak
!outputs/results/.training_completed
!outputs/results/param_counts.csv
!outputs/results/training_summary.csv
!outputs/results/*_loss.csv
!outputs/results/overall_metrics.csv
!outputs/results/node_metrics.csv
!outputs/results/severity_metrics.csv
!outputs/results/confusion_matrix.csv
!outputs/figures/*.png
# Sandbox demo inputs (~700 B each, 10 real test-partition rows in raw units) referenced by sandbox_demo/README.md;
# regenerable with `python -m scripts.make_sandbox_demo`, but only when the raw dataset is present.
!sandbox_demo/*.csv

# Python / Virtual Environments / Caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# IDE & Operating System files
.vscode/
.idea/
.agents/
.DS_Store
Thumbs.db
